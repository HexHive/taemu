# Configuration for the Oversharing artifact evaluation.
# Every value can be overridden in the environment, e.g.
#   AE_JOBS=8 ./ae.sh e3

# Docker image used for all emulator runs (built by ./ae.sh setup).
: "${AE_IMAGE:=ta_emu_ae}"

# Number of emulator containers run in parallel. One emulator saturates a core
# and needs ~85 MB (measured; the budget below is deliberately conservative for
# TAs with a large heap), so the machine is sized by both CPU and memory and the
# smaller of the two wins. Set AE_JOBS explicitly to override.
: "${AE_MEM_PER_JOB_MB:=512}"   # memory budgeted per emulator
: "${AE_RESERVE_MB:=2048}"      # left for the host, docker and the controller
: "${AE_MAX_JOBS:=64}"          # sanity cap on very large machines

if [ -z "${AE_JOBS:-}" ]; then
    _ae_cpus=$(nproc 2>/dev/null || echo 2)
    _ae_by_cpu=$(( _ae_cpus > 3 ? _ae_cpus - 2 : 1 ))
    _ae_mem_mb=$(awk '/^MemAvailable:/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null)
    : "${_ae_mem_mb:=0}"
    if [ "$_ae_mem_mb" -gt 0 ]; then
        _ae_by_mem=$(( (_ae_mem_mb - AE_RESERVE_MB) / AE_MEM_PER_JOB_MB ))
    else
        _ae_by_mem=$_ae_by_cpu
    fi
    [ "$_ae_by_mem" -lt 1 ] && _ae_by_mem=1
    AE_JOBS=$(( _ae_by_cpu < _ae_by_mem ? _ae_by_cpu : _ae_by_mem ))
    [ "$AE_JOBS" -gt "$AE_MAX_JOBS" ] && AE_JOBS=$AE_MAX_JOBS
    [ "$AE_JOBS" -lt 1 ] && AE_JOBS=1
    AE_JOBS_REASON="$_ae_cpus cores -> $_ae_by_cpu, ${_ae_mem_mb} MB available -> $_ae_by_mem"
else
    AE_JOBS_REASON="set explicitly"
fi
export AE_JOBS

# ---------------------------------------------------------------- time budgets
# The paper's campaign used 5 x 24 h of Exploration per TA and 15 min of
# Fetch-Anchored Fuzzing per snapshot (4,330 CPU-hours in total). The defaults
# below are the *scaled-down* budgets used for artifact evaluation; set
# AE_SCALE=paper to run the original budgets (weeks of CPU time).

# Exploration (Stage 1): seconds per TA per repetition.
: "${AE_EXPLORE_TIME:=300}"
# Exploration repetitions per TA (paper: 5).
: "${AE_EXPLORE_REPS:=1}"
# Fetch-Anchored Fuzzing (Stage 2): seconds per snapshot. Kept at the paper's
# budget - with less than ~10 minutes per snapshot the fuzzer rarely
# rediscovers a crash, and rediscovering them is the point of E3.
: "${AE_FAF_TIME:=900}"
# Upper bound on snapshots fuzzed per TA in E3 (paper: all of them).
: "${AE_FAF_MAX_SNAPSHOTS:=6}"

if [ "${AE_SCALE:-ae}" = "paper" ]; then
    AE_EXPLORE_TIME=86400
    AE_EXPLORE_REPS=5
    AE_FAF_TIME=900
    AE_FAF_MAX_SNAPSHOTS=1000000
fi

# ------------------------------------------------------------------ TA subsets
# TAs used by the scaled-down Exploration / FAF experiments. These are the TAs
# behind the vulnerabilities in Table II plus one TA per remaining TEE, so that
# all five TEEs are exercised.
: "${AE_SUBSET:=mitee/harness/377e_double_fetch_stackov \
                mitee/harness/88ce_fuzz \
                qsee/harness/3d08_fuzz \
                beanpod/harness/0801_fuzz \
                teegris/harness/4662436b6d52_fuzz}"

# Set AE_SUBSET=all (or pass --harnesses all) to run every TA the paper
# harnessed: 27 harnesses covering the 30 TAs of Table I - the three Kinibi TAs
# are fuzzed through their Beanpod harnesses, and count for both TEEs.
#
#   AE_SUBSET=all AE_EXPLORE_TIME=3600 ./ae.sh e1_exploration

# Redis is used by the emulator to stream memory-access records to the recorder
# process. Started automatically by ./ae.sh setup.
: "${AE_REDIS_HOST:=localhost}"
: "${AE_REDIS_PORT:=6379}"
