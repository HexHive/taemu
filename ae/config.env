# Configuration for the Oversharing artifact evaluation.
# Every value can be overridden in the environment, e.g.
#   AE_JOBS=8 ./ae.sh e3

# Docker image used for all emulator runs (built by ./ae.sh setup).
: "${AE_IMAGE:=ta_emu_ae}"

# Number of emulator containers run in parallel. One emulator saturates a core
# and needs ~85 MB (measured; the budget below is deliberately conservative for
# TAs with a large heap), so the machine is sized by both CPU and memory and the
# smaller of the two wins. Set AE_JOBS explicitly to override.
: "${AE_MEM_PER_JOB_MB:=512}"   # memory budgeted per emulator
: "${AE_RESERVE_MB:=2048}"      # left for the host, docker and the controller
: "${AE_MAX_JOBS:=64}"          # sanity cap on very large machines

if [ -z "${AE_JOBS:-}" ]; then
    _ae_cpus=$(nproc 2>/dev/null || echo 2)
    _ae_by_cpu=$(( _ae_cpus > 3 ? _ae_cpus - 2 : 1 ))
    _ae_mem_mb=$(awk '/^MemAvailable:/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null)
    : "${_ae_mem_mb:=0}"
    if [ "$_ae_mem_mb" -gt 0 ]; then
        _ae_by_mem=$(( (_ae_mem_mb - AE_RESERVE_MB) / AE_MEM_PER_JOB_MB ))
    else
        _ae_by_mem=$_ae_by_cpu
    fi
    [ "$_ae_by_mem" -lt 1 ] && _ae_by_mem=1
    AE_JOBS=$(( _ae_by_cpu < _ae_by_mem ? _ae_by_cpu : _ae_by_mem ))
    [ "$AE_JOBS" -gt "$AE_MAX_JOBS" ] && AE_JOBS=$AE_MAX_JOBS
    [ "$AE_JOBS" -lt 1 ] && AE_JOBS=1
    AE_JOBS_REASON="$_ae_cpus cores -> $_ae_by_cpu, ${_ae_mem_mb} MB available -> $_ae_by_mem"
else
    AE_JOBS_REASON="set explicitly"
fi
export AE_JOBS

# --------------------------------------------------------- budgets and subset
# The paper's campaign used 5 x 24 h of Exploration per TA and 15 min of
# Fetch-Anchored Fuzzing per snapshot (4,330 CPU-hours in total). The defaults
# below are the *scaled-down* budgets recommended for artifact evaluation: they
# cover all 30 TAs of Table I and finish in well under a day on a commodity
# desktop (8 cores, 16 GB RAM -> AE_JOBS=6, about 8 h for ./ae.sh all), and
# they scale with the machine through AE_JOBS above.
#
#   AE_SCALE=quick   ~1 h smoke run on the five TAs behind Table II
#   AE_SCALE=paper   the paper's own budgets (weeks of CPU time)
#
# Anything set in the environment wins over the AE_SCALE preset, so
# `AE_SCALE=quick AE_SUBSET=all ./ae.sh e1_exploration` does what it says.

_ae_explicit=""
for _v in AE_EXPLORE_TIME AE_EXPLORE_REPS AE_FAF_TIME AE_FAF_MAX_SNAPSHOTS \
          AE_DEDUP_LIMIT AE_SUBSET; do
    eval "[ -n \"\${$_v+x}\" ]" && _ae_explicit="$_ae_explicit $_v"
done
_ae_is_explicit() { case " $_ae_explicit " in *" $1 "*) return 0 ;; esac; return 1; }
_ae_preset() { _ae_is_explicit "$1" || eval "$1=\$2"; }

# The five TAs behind the vulnerabilities in Table II plus one TA per remaining
# TEE, so that a quick run still exercises all five TEEs.
AE_QUICK_SUBSET="mitee/harness/377e_double_fetch_stackov \
                 mitee/harness/88ce_fuzz \
                 qsee/harness/3d08_fuzz \
                 beanpod/harness/0801_fuzz \
                 teegris/harness/4662436b6d52_fuzz"

case "${AE_SCALE:-ae}" in
    quick)
        # Exploration (Stage 1): seconds per TA per repetition.
        _ae_preset AE_EXPLORE_TIME 300
        _ae_preset AE_EXPLORE_REPS 1
        _ae_preset AE_FAF_TIME 900
        _ae_preset AE_FAF_MAX_SNAPSHOTS 6
        _ae_preset AE_DEDUP_LIMIT 150
        _ae_preset AE_SUBSET "$AE_QUICK_SUBSET"
        ;;
    paper)
        _ae_preset AE_EXPLORE_TIME 86400
        _ae_preset AE_EXPLORE_REPS 5
        _ae_preset AE_FAF_TIME 900
        _ae_preset AE_FAF_MAX_SNAPSHOTS 1000000
        _ae_preset AE_DEDUP_LIMIT 0
        _ae_preset AE_SUBSET all
        ;;
    *)
        # Exploration (Stage 1): seconds per TA per repetition (paper: 86400).
        _ae_preset AE_EXPLORE_TIME 1800
        # Exploration repetitions per TA (paper: 5).
        _ae_preset AE_EXPLORE_REPS 1
        # Fetch-Anchored Fuzzing (Stage 2): seconds per snapshot. Kept at the
        # paper's budget - with less than ~10 minutes per snapshot the fuzzer
        # rarely rediscovers a crash, and rediscovering them is the point of E3.
        _ae_preset AE_FAF_TIME 900
        # Upper bound on snapshots fuzzed per TA in E2 (paper: all of them).
        _ae_preset AE_FAF_MAX_SNAPSHOTS 4
        # Recordings per TA considered by the deduplication pass (0 = all, as
        # in the paper). Deduplication is parallel, so all of them is
        # affordable.
        _ae_preset AE_DEDUP_LIMIT 0
        # Every TA the paper harnessed: 27 harnesses covering the 30 TAs of
        # Table I - the three Kinibi TAs are fuzzed through their Beanpod
        # harnesses, and count for both TEEs.
        _ae_preset AE_SUBSET all
        ;;
esac

export AE_EXPLORE_TIME AE_EXPLORE_REPS AE_FAF_TIME AE_FAF_MAX_SNAPSHOTS
export AE_DEDUP_LIMIT AE_SUBSET

# ------------------------------------------------------- python worker pools
# Deduplication, annotation and the plotting code fan out over python worker
# *processes*, each of which holds its own copy of what it is handed - a
# coverage worker peaks around a gigabyte on a long campaign. These pools used
# to be hard-coded (50 workers in the plotting code), which OOM-killed a child
# on smaller machines; the only symptom is
#
#   concurrent.futures.process.BrokenProcessPool: A process in the process
#   pool was terminated abruptly while the future was running or pending
#
# They now size themselves from the cores, the cgroup memory limit and
# MemAvailable, and fall back to running serially if a worker is still killed.
# Nothing has to be set; these are here to pin a pool if you want to.
#
#   AE_POOL_WORKERS      overrides every pool below
#   AE_GRAPH_WORKERS     coverage parsing for Figures 4 and 5
#   AE_ANNOTATE_WORKERS  overlapped-fetch annotation
#   AE_CFG_WORKERS       CFG reachability (eval/graphs/bb.py, standalone only)
#
# and the matching AE_*_WORKER_MB knobs change the assumed peak per worker
# instead of the worker count.

# Redis is used by the emulator to stream memory-access records to the recorder
# process. Started automatically by ./ae.sh setup.
: "${AE_REDIS_HOST:=localhost}"
: "${AE_REDIS_PORT:=6379}"
# Exported so docker-compose.redis.yml publishes the port the emulator probes.
export AE_REDIS_HOST AE_REDIS_PORT
