# ---------------------------------------------------------------- AE output
ae/results/
ae/ae_full_run.log
nohup.out
# working harnesses created by the artifact-evaluation experiments
*/harness/ae_e*_*

# ------------------------------------------------------------ campaign state
# Results of a fuzzing campaign: recorded shared-memory accesses, AFL state,
# snapshots and crashes. Regenerate with ae/ae.sh e1_exploration .. e3_distillation.
*/harness/*/in/
*/harness/*/out/
*/harness/*/df_fuzz/
*/harness/*/record_meta/
*/harness/*/logs/
*/harness_dev/*/in/
*/harness_dev/*/out/
*/harness_dev/*/df_fuzz/
*/harness_dev/*/record_meta/

# emulator run-time droppings (fuzz.sh copies the TA under test into rootfs/)
emulator/rootfs/*.ta
emulator/rootfs/*.json
emulator/rootfs/id:*
emulator/tmp/
emulator/ql-emulator.log*
annotate_fetches_error.txt
# secure-storage objects a TA creates while it runs (the object ID is derived
# from data the fuzzer controls, so the file name is junk)
emulator/emulate/files/*/*-,

# generated evaluation data and figures
eval/bbs_out/
eval/fuzz_graphs/
eval/campaign_out/
eval/graphs/multi_graph_out/
eval/graphs/multi_graph_data/
eval/graphs/*.log
# list of coverage files, built by eval/graphs/bk_suspicious_inputs_covs.sh
.suspicious_inputs_cov_files.txt
# eval/graphs/{rawinfo,df_rawinfo,*_control_flow_graph.png} are the paper's own
# figures and their raw data, and are tracked. The artifact evaluation writes
# its own to ae/results/ (eval/graphs/main.py --out_dir), so a run leaves them
# alone.

# proof-of-concept build output (ndk-build for the phones, gcc for the emulator)
*/pocs/*/obj/
*/pocs/*/libs/
*/pocs/*/poc

# build output (the measured benchmark results in benchmark/results are kept)
optee_shm_patch/benchmark/out/
swarm/target/

# python
**/__pycache__/
*.pyc
